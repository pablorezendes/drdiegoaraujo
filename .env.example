# Modelo sem credenciais. Não habilitar durante a manutenção.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=https://drdiegoaraujo.com
CONTACT_TEAM_EMAIL=
# Identificador da política efetivamente aprovada e exibida ao solicitante.
CONTACT_PRIVACY_VERSION=

# Preencher somente no ambiente seguro do servidor, sem enviar valores por chat.
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS obrigatório; true = TLS desde a conexão (normalmente porta 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Endereço simples de remetente validado/autorizado pelo provedor SMTP.
SMTP_FROM=
